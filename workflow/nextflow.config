// nextflow.config

docker.enabled = false

params {
    // ── Input / Output ────────────────────────────────────────────────────────
    input           = '/home/arkku/group/ics/data/samplesheet.csv'
    outdir          = 'results'
    genome          = 'hg38'

    // ── Container cache ───────────────────────────────────────────────────────
    container_cache = '/home/arkku/group/ics/tools/singularity_cache'

    // ── Resource caps ─────────────────────────────────────────────────────────
    max_cpus        = 32
    max_memory      = '256.GB'
    max_time        = '72.h'

    // ── Cooler resolutions ────────────────────────────────────────────────────
    base_resolution  = 1000
    zoom_resolutions = "10000,25000,50000,100000,500000,1000000"
    // 5000 omitted — too sparse for most OmniC libraries at 1kb base.
    // Add it back with: --zoom_resolutions "5000,10000,25000,50000,100000,500000,1000000"

    // ── Juicer ────────────────────────────────────────────────────────────────
    juicer_jar      = '/home/arkku/group/ics/tools/juicer_tools.2.20.00.jar'
    hic_resolutions = "1000,5000,10000,25000,50000,100000,250000,500000,1000000"

    // ── QC ────────────────────────────────────────────────────────────────────
    qc_resolution   = 10000   // Must exist in zoom_resolutions
}

// ── Genome definitions ────────────────────────────────────────────────────────
params.genomes = [
    'hg38': [
        bwa_index    : '/home/arkku/group/ics/resources/genome/human_GRCH38_gencode_v49/GRCh38.primary_assembly.genome.fa',
        chrom_sizes  : '/home/arkku/group/ics/resources/genome/human_GRCH38_gencode_v49/hg38.chrom.sizes',
        walks_policy : '5unique',
        min_mapq     : 30
    ],
    't2t': [
        bwa_index    : '/home/arkku/group/ics/resources/genome/human_T2T/t2t_genome_clean.fa',
        chrom_sizes  : '/home/arkku/group/ics/resources/genome/human_T2T/t2t.chrom.sizes',
        walks_policy : 'mask',
        min_mapq     : 40
    ]
]

// ── Process resource labels ───────────────────────────────────────────────────
// These must be defined at the top level so they apply across all profiles.
// Without this block, label 'process_high' in your modules gets 1 CPU / 2GB.
process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = '8.GB'
        time   = '4.h'
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '32.GB'
        time   = '12.h'
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = '128.GB'
        time   = '48.h'
    }
}

profiles {

    singularity {
        docker.enabled          = false
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.runOptions  = [
            "--no-home",
            "--bind /home/arkku/group/ics:/home/arkku/group/ics",
            "--bind /home/arkku/group/ics/user_test/Mai_test/run_pipeline/tmp:/tmp",
            "--env MPLCONFIGDIR=/tmp"
        ].join(' ')

        // ── Executor: tell Nextflow to submit jobs to your HPC scheduler ──────
        // Change 'lsf' to 'slurm' if your cluster uses SLURM.
        // Without this, everything runs on the login node regardless of profile.
        executor {
            name            = 'lsf'       // or 'slurm'
            queueSize       = 50          // max concurrent jobs submitted
            submitRateLimit = '10/1min'   // avoid hammering the scheduler
        }

        // ── Default queue — override per-process below if needed ──────────────
        process {
            queue = 'normal'    // your cluster's default queue name

            withName: 'FASTP' {
                container = "${params.container_cache}/fastp_1.3.1.sif"
            }
            withName: 'BWA_MEM2' {
                container = "${params.container_cache}/bwa_mem2_2.2.1.sif"
                queue     = 'highmem'   // BWA needs large RAM — use highmem queue
            }
            withName: 'PAIRTOOLS_PARSE' {
                container = "${params.container_cache}/pairtools_1.1.3.sif"
            }
            withName: 'PAIRTOOLS_MERGE_DEDUP' {
                container = "${params.container_cache}/pairtools_1.1.3.sif"
                queue     = 'highmem'   // Merge+sort across batches is RAM-heavy
            }
            withName: 'COOLER' {
                container = "${params.container_cache}/cooler_0.9.3.sif"
            }
            withName: 'JUICER' {
                container = "${params.container_cache}/juicer.sif"
                queue     = 'highmem'
            }
            withName: 'COOLTOOLS_SCALING' {
                container = "${params.container_cache}/cooltools.sif"
            }
        }
    }

    // ── Local profile — small test datasets only ──────────────────────────────
    local {
        docker.enabled  = false
        executor.name   = 'local'

        process {
            cpus   = { [params.max_cpus,   task.attempt * 4].min() }
            memory = { [params.max_memory.toGiga(), task.attempt * 8].min() + '.GB' }
            time   = params.max_time
        }
    }

    // ── Test profile — dry run with stub processes ────────────────────────────
    // Run with: nextflow run main.nf -profile test,singularity -stub
    test {
        params.input  = 'test/metadata_test.csv'
        params.outdir = './test_results'
        params.genome = 'hg38'

        process {
            cpus   = 2
            memory = '8.GB'
            time   = '1.h'
        }
    }
}

// ── Work directory and cleanup ────────────────────────────────────────────────
workDir = '/home/arkku/group/ics/user_test/Mai_test/run_pipeline/work'
// Uncomment once pipeline is validated — removes intermediate work dirs
// automatically after a successful run to avoid filling scratch storage.
// cleanup = true